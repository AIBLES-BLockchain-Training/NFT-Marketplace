# Environment Variables Example
# Copy to .env and fill in your values

# Fee recipient wallet address (optional - defaults to deployer)
FEE_RECIPIENT=0x5E2df4dc3F8aE246034AB02e147341e5d5A098B4

# Private keys (DO NOT commit to git)
# BSC_ACCOUNT_PRIVATE=your_private_key_here
# ETH_ACCOUNT_PRIVATE=your_private_key_here

# API Keys (DO NOT commit to git) 
# BSCSCAN_API_KEY=your_bscscan_api_key
# ETHERSCAN_API_KEY=your_etherscan_api_key